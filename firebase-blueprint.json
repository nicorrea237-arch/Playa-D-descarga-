{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated La Emilia operator profile restricted to @laemilia.com.ar domain.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified corporate email ending in @laemilia.com.ar",
          "minLength": 16,
          "maxLength": 254,
          "pattern": "^[^@]+@laemilia\\.com\\.ar$"
        },
        "displayName": {
          "type": "string",
          "description": "Operator display name",
          "minLength": 1,
          "maxLength": 120
        },
        "domain": {
          "type": "string",
          "description": "Corporate email domain",
          "enum": ["laemilia.com.ar"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account first login server timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last login server timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "domain", "createdAt", "lastLoginAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private operator profile document restricted strictly to the authenticated @laemilia.com.ar owner."
    }
  }
}
